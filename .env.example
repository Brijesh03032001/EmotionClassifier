# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_ACCESS_TOKEN=

# Comma-separated playlist IDs for bulk extraction
SPOTIFY_PLAYLIST_IDS=37i9dQZF1DXcBWIGoYBM5M,37i9dQZF1DX4WYpdVIPcm4

# Target unique track count for dataset
TARGET_TRACKS=1500

# Single playlist (optional, legacy)
SPOTIFY_PLAYLIST_ID=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_TABLE=spotify_raw_features
SUPABASE_TARGET_TABLE=deeser_songs
